{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 38, // Waybar height (to be removed for auto height)
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    // "width": 1280, // Waybar width
    "spacing": 5, // Gaps between glass modules
    // Choose the order of the modules
    // "modules-left": ["hyprland/workspaces", "tray", "mpd"],
    // "modules-center": ["hyprland/window"],
    "modules-left": ["niri/workspaces", "mpd"],
    "modules-center": ["niri/window"],
    "modules-right": ["keyboard-state", "bluetooth", "network", "cpu", "memory", "disk", "wireplumber", "backlight", "battery", "clock", "idle_inhibitor", "tray"],
    // Modules configuration
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        // "format": "{name}: {icon}",
        "format": "{name}: {windows}",
    	"format-window-separator": " ",
            // "format-icons": {
            //     "1": "",
            //     "2": "",
            //     "3": "",
            //     "4": "",
            //     "5": "",
            //     "urgent": "",
            //     "focused": "",
            //     "default": ""
            // },
    	"window-rewrite-default": "",
    	"window-rewrite": {
    	    "firefox": "",
    	    "Alacritty": "",
    	    "kitty": "󰄛",
    	    "Clash for Windows": "󰀝",
    	    "SPlayer": "",
    	    "Bluetooth Devices": "󰂯",
    	    "pavucontrol": "󱀞",
    	    "QQ": "",
    	    "org.photoqt.photoqt": "",
    	    "pdf": "",
    	    "baidunetdisk": "",
    	    "neovide": "",
            "Dunst": "",
            "Zotero": "󰰸",
            "Obsidian": "",
            "zen": "󰺕",
            "code": "",
            "dev.zed.Zed-Preview": "",
            "com.dec05eba.gpu_screen_recorder": "󰑋"
    	},
    },
    "hyprland/window": {
	    "format": "{}",
	    "rewrite": {
		    "Mozilla Firefox": " ",
		    ".* Mozilla Firefox": " ",
		    "(.*) .* Electron NCM": " $1",
		    "(Volume Control)": "󱀞 $1",
		    "Bluetooth Devices": "󰂯",
		    "QQ": " ",
		    "(.*) .* PhotoQt Image Viewer": " $1",
		    "(.*) .* WPS PDF": " $1",
		    "百度网盘": " ",
		    "": "󰣇 ",
            ".* Zen Browser": "󰺕 ",
            ".* Visual Studio Code": " ",
            "(.*) - .* - Obsidian .*": " ",
            "(.*) - Zotero": "󱛉 "
	    },
	    "separate-outputs": true
    },
    "niri/workspaces": {
        // "on-update": "sudo pacman -Syu",
        "format": "{icon}",
    	"format-icons": {
    		// Named workspaces
    		// (you need to configure them in niri)
            "daily": "",
            "work": "",
            "chat": "",

    		// Icons by state
    		// "active": " ",
    		"default": " "
    	}
    },
    "niri/window": {
        // "icon + brief info": matches windows by app_id (reliable), not by title.
        // The format appends the app_id after an invisible separator (␟, U+241F);
        // the last two rules strip it again, so it never shows.
        "format": " {title}␟{app_id}",
        "max-length": 60,
        "rewrite": {
            // Browsers
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟firefox": " $1",
            " ((?:(?! - | — ).)*?)␟firefox": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟google-chrome": " $1",
            " ((?:(?! - | — ).)*?)␟google-chrome": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟com.google.Chrome": " $1",
            " ((?:(?! - | — ).)*?)␟com.google.Chrome": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟zen": " $1",
            " ((?:(?! - | — ).)*?)␟zen": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟app.zen_browser.zen": " $1",
            " ((?:(?! - | — ).)*?)␟app.zen_browser.zen": " $1",
            // Editors
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟code": " $1",
            " ((?:(?! - | — ).)*?)␟code": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟com.microsoft.VSCode": " $1",
            " ((?:(?! - | — ).)*?)␟com.microsoft.VSCode": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟vscodium": " $1",
            " ((?:(?! - | — ).)*?)␟vscodium": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟codium": " $1",
            " ((?:(?! - | — ).)*?)␟codium": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟md.obsidian.Obsidian": " $1",
            " ((?:(?! - | — ).)*?)␟md.obsidian.Obsidian": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟obsidian": " $1",
            " ((?:(?! - | — ).)*?)␟obsidian": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟Zotero": "󰗚 $1",
            " ((?:(?! - | — ).)*?)␟Zotero": "󰗚 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟org.zotero.Zotero": "󰗚 $1",
            " ((?:(?! - | — ).)*?)␟org.zotero.Zotero": "󰗚 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟dev.zed.Zed": " $1",
            " ((?:(?! - | — ).)*?)␟dev.zed.Zed": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟dev.zed.Zed-Preview": " $1",
            " ((?:(?! - | — ).)*?)␟dev.zed.Zed-Preview": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟nvim": " $1",
            " ((?:(?! - | — ).)*?)␟nvim": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟neovim": " $1",
            " ((?:(?! - | — ).)*?)␟neovim": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟neovide": " $1",
            " ((?:(?! - | — ).)*?)␟neovide": " $1",
            // Terminals
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟Alacritty": " $1",
            " ((?:(?! - | — ).)*?)␟Alacritty": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟kitty": "󰏩 $1",
            " ((?:(?! - | — ).)*?)␟kitty": "󰏩 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟net.kovidgoyal.kitty": "󰏩 $1",
            " ((?:(?! - | — ).)*?)␟net.kovidgoyal.kitty": "󰏩 $1",
            // Music & media
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟electron-ncm": " $1",
            " ((?:(?! - | — ).)*?)␟electron-ncm": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟netease-cloud-music": " $1",
            " ((?:(?! - | — ).)*?)␟netease-cloud-music": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟SPlayer": " $1",
            " ((?:(?! - | — ).)*?)␟SPlayer": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟mpv": " $1",
            " ((?:(?! - | — ).)*?)␟mpv": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟io.mpv": " $1",
            " ((?:(?! - | — ).)*?)␟io.mpv": " $1",
            // Chat
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟qq": " $1",
            " ((?:(?! - | — ).)*?)␟qq": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟com.tencent.qq": " $1",
            " ((?:(?! - | — ).)*?)␟com.tencent.qq": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟wechat": "󰘑 $1",
            " ((?:(?! - | — ).)*?)␟wechat": "󰘑 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟WeChat": "󰘑 $1",
            " ((?:(?! - | — ).)*?)␟WeChat": "󰘑 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟com.tencent.WeChat": "󰘑 $1",
            " ((?:(?! - | — ).)*?)␟com.tencent.WeChat": "󰘑 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟wechat-universal": "󰘑 $1",
            " ((?:(?! - | — ).)*?)␟wechat-universal": "󰘑 $1",
            // System & tools
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟pavucontrol": "󰕾 $1",
            " ((?:(?! - | — ).)*?)␟pavucontrol": "󰕾 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟org.pulseaudio.pavucontrol": "󰕾 $1",
            " ((?:(?! - | — ).)*?)␟org.pulseaudio.pavucontrol": "󰕾 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟blueman-manager": "󰂯 $1",
            " ((?:(?! - | — ).)*?)␟blueman-manager": "󰂯 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟org.bluez.obex": "󰂯 $1",
            " ((?:(?! - | — ).)*?)␟org.bluez.obex": "󰂯 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟blueberry": "󰂯 $1",
            " ((?:(?! - | — ).)*?)␟blueberry": "󰂯 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟com.west2online.ClashForWindows": "󰒘 $1",
            " ((?:(?! - | — ).)*?)␟com.west2online.ClashForWindows": "󰒘 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟moe.launcher.ClashVerge": "󰒘 $1",
            " ((?:(?! - | — ).)*?)␟moe.launcher.ClashVerge": "󰒘 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟steam": " $1",
            " ((?:(?! - | — ).)*?)␟steam": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟com.valvesoftware.Steam": " $1",
            " ((?:(?! - | — ).)*?)␟com.valvesoftware.Steam": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟com.dec05eba.gpu_screen_recorder": "󰑋 $1",
            " ((?:(?! - | — ).)*?)␟com.dec05eba.gpu_screen_recorder": "󰑋 $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟dunst": " $1",
            " ((?:(?! - | — ).)*?)␟dunst": " $1",
            // Files & office
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟org.photoqt.photoqt": " $1",
            " ((?:(?! - | — ).)*?)␟org.photoqt.photoqt": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟wps-office-pdf": " $1",
            " ((?:(?! - | — ).)*?)␟wps-office-pdf": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟wps-office-wps": " $1",
            " ((?:(?! - | — ).)*?)␟wps-office-wps": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟wps-office-et": " $1",
            " ((?:(?! - | — ).)*?)␟wps-office-et": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟wps-office-wpp": " $1",
            " ((?:(?! - | — ).)*?)␟wps-office-wpp": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟com.baidu.baidunetdisk": " $1",
            " ((?:(?! - | — ).)*?)␟com.baidu.baidunetdisk": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟baidunetdisk": " $1",
            " ((?:(?! - | — ).)*?)␟baidunetdisk": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟picgo": " $1",
            " ((?:(?! - | — ).)*?)␟picgo": " $1",
            " ((?:(?! - | — ).)*?)(?: - | — ).*␟org.gnome.Nautilus": "󰉋 $1",
            " ((?:(?! - | — ).)*?)␟org.gnome.Nautilus": "󰉋 $1",
            // unknown app: cut long title to first segment, then strip the app_id
            " (.*?)(?: - | — ).*␟.*": " $1",
            " (.*?)␟.*": " $1"
        },
        "separate-outputs": true
    },

    "keyboard-state": {
        "numlock": false,
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        },
	"binding-keys": [1, 69, 70]
    },
    "backlight/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal",
        "device": "nvidia_0"
    },
    "disk": {
        "format": "󰨣",
        "states": {
            "warning": 70,
            "critical": 90
        },
	    "tooltip-format": "Disk: {used}/{total} ({percentage_used}% used)"
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 2,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "Title: {title}\nAlbum: {album} - {date}\nTime: {elapsedTime:%M:%S}/{totalTime:%M:%S}\nQueue: {songPosition}/{queueLength}",
        "tooltip-format-disconnected": "MPD (disconnected)",
    	"on-click": "kitty -e ncmpcpp",
    	"max-length": 20
    },
    // "idle_inhibitor": {
    //     "format": "{icon}",
    //     "format-icons": {
    //         "activated": "",
    //         "deactivated": ""
    //     }
    // },
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        // "timezone": "America/New_York",
    	"format": "{:%H:%M} ",
        "timezone": "Asia/Shanghai",
    	"tooltip-format": "{:%Y-%m-%d}",
        // "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        // "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": " {icon}",
	    "tooltip-format": "CPU usage: {usage}%\nLoad: {load}",
	    "interval": 1,
        "format-icons": [
             "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"
        ]
    },
    "memory": {
	    "format": " {icon}",
	    "interval": 2,
	    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
	    "tooltip-format": "RAM: {used:0.1f}G/{total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G/{swapTotal:0.1f}G ({swapPercentage}%)"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C",
        "format-icons": [
             "<span color='#2aa9ff'></span>", // blue
             "<span color='#f8f8f2'></span>", // white
             "<span color='#dd532e'></span>"  // red
	],
	"tooltip-format": "Temperature: {temperatureC}°C"
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
        "tooltip-format": "Brightness: {percent}%"
    },
    "battery": {
    	"bat": "BAT0",
    	"adapter": "ADP0",
            "states": {
                // "good": 95,
                "warning": 30,
                "critical": 15
            },
            "format": "{icon}",
            "format-charging": "{icon} ",
            "format-plugged": "{icon} ",
            "format-alt": "{time} {icon}",
            // "format-good": "", // An empty format will hide the module
            // "format-full": "",
            "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
	"interval": 1,
	"format": "󰅛",
        "format-disconnected": "󰅛",
	"format-wifi": "{icon}",
        "format-ethernet": "󰱓",
	"format-linked": "󰛵",
        "tooltip-format": "{ifname}({essid}) via {gwaddr} \nIP address: {ipaddr}/{cidr} \nUp: {bandwidthUpBytes}, Down: {bandwidthDownBytes}\nStrength: {signalStrength}%",
        // "format-wifi": "{essid} ({signalStrength}%) ",
        // "format-ethernet": "{ipaddr}/{cidr} ",
        // "format-linked": "{ifname} (No IP) ",
        // "format-alt": "{ifname}: {ipaddr}/{cidr}",
	"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}",
        "format-bluetooth": "{icon}",
        "format-bluetooth-muted": "",
        "format-muted": "",
        "format-source": "",
        "format-source-muted": "",
        "tooltip-format": "{volume}% {desc}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "",
        "format-source": "",
        "format-source-muted": "",
        "tooltip-format": "{volume}% {node_name}",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pwvucontrol"
    },
    "bluetooth": {
    	"format": "",
    	"format-disabled": "󰂲",
    	"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    	"on-click": "bluetooth toggle"
    },
    "custom/media": {
        "format": "{icon} {}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "on-click": "swaylock -f -i $HOME/dotfiles/wallpapers/red_circuit.png"
    }
}
