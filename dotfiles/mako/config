# Mako notification daemon configuration (managed by dotfiles)
#
# Appearance: light macOS-inspired cards with translucent surfaces.
#
# Sounds: mako has no audio engine of its own -- sound is played by an
# `on-notify=exec` hook. The chimes live in sounds/ (next to this file, so
# ~/.config/mako/sounds/) and are synthesised by sounds/generate.py rather
# than copied from Apple, whose alert tones are copyrighted. Regenerate or
# retune them with: python3 ~/.config/mako/sounds/generate.py
# To audition: for f in ~/.config/mako/sounds/*.oga; do paplay "$f"; done

# ── appearance ──────────────────────────────────────────────────────

# Light card background, dark text, hairline border, rounded corners.
background-color=#F5F5F7EE
text-color=#1D1D1F
border-color=#00000014
border-size=1
border-radius=14

# Cantarell is the closest installed sans-serif to the macOS shell.
font=Cantarell 13

# Notification box width in logical px. Mako keeps one fixed width per rule
# (it cannot auto-size to the text), so widths are tuned per message type:
# long question text gets the widest box (the absolute cap), short "finished"
# pings get a narrow one, everything else sits in between.
width=360

# ── behavior ────────────────────────────────────────────────────────
#
# mako's built-in default-timeout is 0, i.e. notifications are never
# auto-dismissed and stay on screen until clicked/dismissed. This includes
# niri's screenshot notification, which is sent with expire_timeout = -1
# ("daemon decides"), so mako falls back to default-timeout below.
#
# Auto-dismiss such notifications after 5 seconds (value in milliseconds).
default-timeout=5000

# ── DSH question notifications are sticky + red-bordered + sound ────
# Urgent questions from the plugin get a red frame and the iPhone alert:
# an ascending 1-5-8 marimba arpeggio, which cuts through and is instantly
# recognisable as "something wants you".
# Exact strings, matching the plugin's notify-send call:
#   notify-send -a dsh "dsh needs your input" ...
[app-name=dsh summary="dsh needs your input"]
default-timeout=0
border-color=#FF453A
on-notify=exec paplay $HOME/.config/mako/sounds/tri-tone.oga

# ── agent finished: the iPhone alert, same as the question above ─────
# `makoctl history` shows both agents arrive under other app names, so a
# summary match would need one block each; matching app-name=dsh for the
# DSH "dsh finished" summary and any kitty notification covers them.
[app-name=dsh summary="dsh finished"]
on-notify=exec paplay $HOME/.config/mako/sounds/tri-tone.oga

# ── kitty notifications play the same completion chime ───────────────
# Claude Code and codex both surface here: mako reports Claude Code's
# "Claude Code" notification and codex's "agent-turn-complete" notify
# with app-name "kitty", because kitty forwards them and the terminal
# supplies its own app id. So match the terminal rather than each agent.
[app-name=kitty]
on-notify=exec paplay $HOME/.config/mako/sounds/tri-tone.oga

# ── Amp in the browser: same chime as the terminal ──────────────────
# The web app has no terminal to forward through, so its notifications
# come from the browser itself. `makoctl history -j` shows them as
# app_name "Zen" + desktop_entry "zen", with the thread title as the
# summary and the reply as the body -- unlike the CLI there is no "amp"
# string to match on, so match the browser instead (which means every
# site's notifications chime, the same tradeoff the kitty block makes).
# desktop_entry is the stable one: app_name is the .desktop Name and
# would change with a translated/renamed entry.
[desktop-entry=zen]
on-notify=exec paplay $HOME/.config/mako/sounds/tri-tone.oga
