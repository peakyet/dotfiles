# Mako notification daemon configuration (managed by dotfiles)
#
# Appearance: Catppuccin Latte (light style) with rounded corners.
# Palette: https://github.com/catppuccin/catppuccin (latte)

# ── appearance ──────────────────────────────────────────────────────

# Light card background, dark text, blue border, rounded corners.
background-color=#eff1f5
text-color=#4c4f69
border-color=#89b4fa
border-size=2
border-radius=12

# Same font family as the terminal (kitty: "Maple Mono NF CN" @ 12),
# bumped up in size for glanceable notifications.
font=Maple Mono NF CN 14

# ── behavior ────────────────────────────────────────────────────────
#
# mako's built-in default-timeout is 0, i.e. notifications are never
# auto-dismissed and stay on screen until clicked/dismissed. This includes
# niri's screenshot notification, which is sent with expire_timeout = -1
# ("daemon decides"), so mako falls back to default-timeout below.
#
# Auto-dismiss such notifications after 5 seconds (value in milliseconds).
default-timeout=5000

# ── DSH question notifications are sticky + red-bordered ─────────────
# Urgent questions from the plugin get a red frame to grab attention.
# Exact strings, matching the plugin's notify-send call:
#   notify-send -a dsh "dsh needs your input" ...
[app-name=dsh summary="dsh needs your input"]
default-timeout=0
border-color=#d20f39